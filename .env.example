# ===========================================================================
# RAGifier AI — configuration
#
#   cp .env.example .env     then edit. .env is gitignored; keep it that way.
#
# The only thing you MUST set is a model. Everything else has a working
# default, including search — RAGifier runs with no embedding server at all.
# ===========================================================================


# ===========================================================================
# 1. WHICH MODEL  —  the single variable swap
# ===========================================================================
#   cloud  ->  CLOUD_* is the primary, LOCAL_* becomes the fallback
#   local  ->  LOCAL_* is the primary, CLOUD_* becomes the fallback
#
# Fill in both and you get automatic failover. Fill in one and there is no
# fallback. Switching is a one-word edit.
LLM_PROVIDER=cloud


# --- CLOUD model -----------------------------------------------------------
# Any OpenAI-compatible endpoint:
#   OpenAI      https://api.openai.com/v1              gpt-4o-mini
#   NVIDIA NIM  https://integrate.api.nvidia.com/v1    meta/llama-3.3-70b-instruct
#   Groq        https://api.groq.com/openai/v1         llama-3.3-70b-versatile
#   OpenRouter  https://openrouter.ai/api/v1           anthropic/claude-3.5-sonnet
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_API_KEY=sk-REPLACE_ME
CLOUD_MODEL=gpt-4o-mini
CLOUD_LABEL=
#CLOUD_TEMPERATURE=0.2
#CLOUD_EXTRA_BODY=


# --- LOCAL model -----------------------------------------------------------
# Ollama, LM Studio, vLLM, llama.cpp. Note the /v1 suffix.
# Must support TOOL CALLING, or it will chat but never read your documents.
# Known good: qwen2.5, qwen3, llama3.1/3.3, mistral-nemo.
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=local
LOCAL_MODEL=qwen2.5:14b
LOCAL_LABEL=
#LOCAL_TEMPERATURE=0.2
#LOCAL_EXTRA_BODY=


# --- Model timeouts --------------------------------------------------------
# LLM_HARD_TIMEOUT is the one that prevents a wedged request hanging the UI
# forever. Keep it above LLM_REQUEST_TIMEOUT. Leave retries at 0 — the SDK
# retries twice by default, turning a 60s timeout into 3 minutes of silence.
LLM_REQUEST_TIMEOUT=60
LLM_HARD_TIMEOUT=75
LLM_MAX_RETRIES=0
LLM_COOLDOWN=120


# ===========================================================================
# 2. SEARCH
# ===========================================================================
# EMBED_PROVIDER decides how large documents are searched:
#
#   none   keyword search only (BM25). Works out of the box, no server, no
#          API cost. Good at exact terms — error codes, names, part numbers.
#          Weaker when your wording differs from the document's.
#
#   local  your own Ollama. Private, free, needs a model pulled:
#              ollama pull nomic-embed-text
#
#   cloud  a hosted embeddings endpoint. Best quality, costs a little, and
#          SENDS YOUR DOCUMENT TEXT TO THAT PROVIDER. Don't use it for
#          anything confidential.
#
# With local or cloud, both vector AND keyword search run and the rankings are
# fused — they fail in different ways, so together they beat either alone.
EMBED_PROVIDER=none

# --- local (Ollama) --------------------------------------------------------
EMBED_LOCAL_URL=http://localhost:11434
EMBED_LOCAL_MODEL=nomic-embed-text

# --- cloud -----------------------------------------------------------------
EMBED_CLOUD_URL=https://api.openai.com/v1
EMBED_CLOUD_API_KEY=
EMBED_CLOUD_MODEL=text-embedding-3-small

EMBED_TIMEOUT=120
EMBED_BATCH=64


# ===========================================================================
# 3. THE SMALL-vs-LARGE DECISION
# ===========================================================================
# A document is handled one of two ways, chosen automatically by size:
#
#   CONTEXT  small enough to hand the model whole. No chunking, no embedding,
#            no retrieval step — so nothing can be missed by a bad search.
#   INDEXED  too big for that: chunked, embedded, searched per question.
#
# CONTEXT_TOKEN_BUDGET is the threshold AND the shared pool. Several small
# documents share it; once the total would exceed it, later ones are indexed,
# so uploading a fifth short file cannot quietly evict the first four.
#
# 6000 tokens is roughly 24k characters, about 10–12 pages of prose. Raise it
# if your model has a big context window and you prefer full-text accuracy;
# lower it if you are paying per token.
CONTEXT_TOKEN_BUDGET=6000

# Chunking for indexed documents. 1100 chars ≈ 275 tokens.
CHUNK_CHARS=1100
CHUNK_OVERLAP=200

# How many passages to retrieve per question, and the ceiling on how much
# material is handed to the model for one answer.
RETRIEVE_TOP_K=8
ANSWER_CONTEXT_TOKENS=10000


# ===========================================================================
# 4. SERVER
# ===========================================================================
APP_NAME=RAGifier AI
PORT=8808

# Loopback by default, and that is the right default. The websocket is plain
# ws://, and your documents' contents travel over it. On 0.0.0.0 anyone who can
# reach the port can read everything you have uploaded.
HOST=127.0.0.1

OPEN_BROWSER=true

# Largest file accepted, megabytes.
MAX_UPLOAD_MB=200

# Where extracted text and indexes live. These contain the full text of your
# documents — it is gitignored, keep it that way.
#STORAGE_DIR=storage

TOOL_BUDGET=8

# Extra instructions appended to the system prompt. Good place for "always
# answer in British English" or "this is a legal corpus, quote exactly".
#SYSTEM_PROMPT_EXTRA=
